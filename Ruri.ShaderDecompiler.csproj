<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ruri.ShaderDecompiler</RootNamespace>
    <AssemblyName>Ruri.ShaderDecompiler</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FModel\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
    <ProjectReference Include="..\..\FModel\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-process spirv-cross. Ships the native spirv-cross.dll (runtimes/win-x64/native),
         kept current via the package; the decompiler P/Invokes the stable spvc_* C ABI directly.
         dxil-spirv-c-shared.dll and dxilconv.dll have no NuGet distribution and ship under Tools/. -->
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tools\Compat\**\*.cs" />
    <Compile Remove="Tools\src\**\*.cs" />
    <Compile Remove="Tools\build\**\*.cs" />
    <EmbeddedResource Remove="Tools\Compat\**\*.resx" />
    <EmbeddedResource Remove="Tools\src\**\*.resx" />
    <EmbeddedResource Remove="Tools\build\**\*.resx" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
