<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ruri.ShaderDecompiler</RootNamespace>
    <AssemblyName>Ruri.ShaderDecompiler</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FModel\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
    <ProjectReference Include="..\..\FModel\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-process spirv-cross. Ships the native spirv-cross.dll (runtimes/win-x64/native),
         kept current via the package; the decompiler P/Invokes the stable spvc_* C ABI directly. -->
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" Version="2.23.0" />
    <!-- In-process dxil-spirv. AssetRipper's binding bundles dxil-spirv-c-shared.dll
         (runtimes/<rid>/native) cross-platform; we P/Invoke the dxil_spv_* C ABI directly. Its
         bundled dxbc-spirv translates legacy SM5 DXBC directly (no Microsoft dxilconv). Pinned for
         reproducibility across the synced dual-machine workspace and because ScalarCbufferVectorizer
         is validated against this build — bump deliberately. -->
    <PackageReference Include="AssetRipper.Bindings.DxilSpirV" Version="1.1.1-nightly.129" />
  </ItemGroup>


</Project>
